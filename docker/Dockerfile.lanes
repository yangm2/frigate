# Overlay build for detect.lanes: layers this branch's five changed files
# onto the stock upstream image, rather than rebuilding go2rtc/nginx/the web
# UI from scratch. Lives here (not in the Talos IaC repo that builds it) so
# it travels with the exact commit its COPY paths were cut against — see the
# build Job that invokes this, which uses this repo as Kaniko's git context.
#
# Base tag MUST match this branch's parent tag (v0.18.3). Bumping it
# means rebasing the branch onto the new tag first, or the base's
# video/detect.py/app.py no longer match what these five files expect around
# them. (Was v0.17.2 — rebased 2026-08-08 to pick up ffmpeg 8.0, required for
# the Reolink Duo3 http-flv bridge; frigate/video.py became frigate/video/
# in upstream's "Split apart video.py" #22631 during that rebase, hence the
# COPY destination change below. Rebased again 2026-09-15 from v0.18.0-beta3
# onto stable v0.18.0, then onto v0.18.2 for its security fixes — both
# clean rebases, no conflicts; upstream touched none of the five COPY'd
# files between v0.18.0 and v0.18.2, so the overlay reverts none of them.
# Rebased onto v0.18.3 on 2026-11-20 for its nginx 1.27.4 -> 1.30.7 bump,
# GHSA-7822-v38f-8p44 / CVE-2026-123007, HTTP/2 RCE as root; clean again,
# none of the five files changed between v0.18.2 and v0.18.3.)
FROM ghcr.io/blakeblackshear/frigate:0.18.3-tensorrt

# Mesa 25.0.7 from bookworm-backports for VAAPI decode on the AMD iGPU (VCN
# 3.1.2). The base's apt sources are bookworm only, so it carries Debian 12's
# Mesa 22.3.6 (Dec 2022); bookworm-backports builds 25.0.7 against bookworm's
# own libraries, unlike pulling trixie's. Why (yangm2/scripts,
# Talos/k8s/amdgpu-probe/ANALYSIS.md, hypothesis T1'): 22.3.6 tells VCN the
# decode target is twice its size (dt_size sums two planes that share one
# BO; fixed by 23.3) and allocates H.264 tier-2 DPB buffers with no slack at
# 2560x1920, and the doorbell's VCN decode faults just past such a buffer and
# wedges the GPU. 25.0.7 allocates those as video buffers with a DPB bind.
# Dry-run on the base, 2026-11-17: upgrades libdrm 2.4.114 -> 2.4.123 and the
# Mesa packages, adds mesa-libgallium/libgbm1/libwayland-server0, removes
# nothing. The last line fails the build if the VA driver is not 25.x.
RUN echo "deb http://deb.debian.org/debian bookworm-backports main" \
        > /etc/apt/sources.list.d/bookworm-backports.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends -t bookworm-backports mesa-va-drivers \
    && rm -rf /var/lib/apt/lists/* \
    && grep -a -o -m1 -E "Mesa 25\.[0-9]+\.[0-9]+" /usr/lib/x86_64-linux-gnu/dri/radeonsi_drv_video.so

COPY frigate/video/detect.py /opt/frigate/frigate/video/detect.py
COPY frigate/app.py /opt/frigate/frigate/app.py
COPY frigate/camera/maintainer.py /opt/frigate/frigate/camera/maintainer.py
COPY frigate/config/camera/detect.py /opt/frigate/frigate/config/camera/detect.py
COPY frigate/object_detection/parallel.py /opt/frigate/frigate/object_detection/parallel.py
